    match /users/{userId} {
      // Only owners (or admins) can read/write their documents
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId)
        && !request.resource.data.keys().hasAny(['isAdmin']));
      allow update: if isAdmin() || (isOwner(userId)
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(['isAdmin']));
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /eventos/{eventId} {
      // Public read, admin write only
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lista_geral/{messageId} {
      // Not used for chat in client (uses Realtime DB). Keep admin-only here.
      allow read, write: if isAdmin();
    }

    match /produtos/{productId} {
      // Allow anyone to read produtos (public store)
      allow read: if true;
      // Allow admin users to write produtos
      allow write: if isAdmin();
    }

    match /categorias/{categoryId} {
      // Allow anyone to read categories (public store)
      allow read: if true;
      // Allow admin users to write categories
      allow write: if isAdmin();
    }

    match /carrinho/{cartId} {
      // Only the owner can read/write their cart
      allow read, write: if isOwner(cartId) || isAdmin();

      // Subcollection for cart items
      match /items/{itemId} {
        allow read, write: if isOwner(cartId) || isAdmin();
      }
    }

    match /pedidos/{orderId} {
      // Users can create and read their own orders; admin can manage all
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /duvidas/{questionId} {
      // Authenticated users can read/create; admin can update/delete
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();

      // Subcollection for replies/answers
      match /respostas/{replyId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

