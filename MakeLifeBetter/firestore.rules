rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_config/{docId} {
      // Public read for remote theme/config, admin writes only
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    match /users/{userId} {
      // Allow authenticated users to read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow unauthenticated users to query by username (for login lookup)
      allow read: if resource.data.username != null;
    }

    match /eventos/{eventId} {
      // Allow anyone to read events (public)
      allow read: if true;
      // Only admin can create, update and delete events
      allow create, update, delete: if request.auth.token.admin == true;
    }

    match /lista_geral/{messageId} {
      // Allow authenticated users to read and write chat messages
      allow read, write: if request.auth != null;
    }

    match /produtos/{productId} {
      // Allow anyone to read produtos (public store)
      allow read: if true;
      // Only admin can write produtos
      allow write: if request.auth.token.admin == true;
    }

    match /categorias/{categoryId} {
      // Allow anyone to read categories (public store)
      allow read: if true;
      // Only admin can write categories
      allow write: if request.auth.token.admin == true;
    }

    match /carrinho/{cartId} {
      // Allow authenticated users to read and write their own cart
      allow read, write: if request.auth != null;

      // Subcollection for cart items
      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }

    match /pedidos/{orderId} {
      // Allow authenticated users to read and write orders
      allow read, write: if request.auth != null;
    }

    match /duvidas/{questionId} {
      // Allow authenticated users to read and write questions
      allow read, write: if request.auth != null;

      // Subcollection for replies/answers
      match /respostas/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }

    match /event_location/{locationId} {
      // Allow anyone to read event location
      allow read: if true;
      // Only admin can write event location
      allow write: if request.auth.token.admin == true;

      // Subcollection for contacts
      match /contacts/{contactId} {
        allow read: if true;
        // Only admin can write contacts
        allow write: if request.auth.token.admin == true;
      }
    }

    match /banners/{bannerId} {
      // Allow anyone to read banners
      allow read: if true;
      // Only admin can write banners
      allow write: if request.auth.token.admin == true;
    }

    // Block direct access to system documents
    match /_system/{docId} {
      allow read, write: if false;
    }
  }
}
